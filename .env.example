# Скопируйте в .env (файл .env не коммитится) и заполните.

# Ссылка GET из задания организаторов (кнопка «Открыть GET для DEV»): адрес вместе с параметрами подписи.
# group_id сервер подставляет сам.
CQA_DATA_API=

# Ключ Claude API для облачной оценки (можно задать и в интерфейсе, раздел «Модель»).
ANTHROPIC_API_KEY=

# Порт сервера (по умолчанию 8000).
PORT=8000

# Название команды для results.json (поле team_name); можно задать и на экране «Модель».
CQA_TEAM_NAME=

# Локальная модель через релей и туннель (задаётся на Railway, не в интерфейсе).
# Адрес туннеля к tools/ollama_relay.py и тот же токен, что в .env.relay на компьютере с Ollama.
# Если заданы оба, адрес из интерфейса «Модель → Локальная модель» не используется.
CQA_LOCAL_RELAY_URL=
CQA_LOCAL_RELAY_TOKEN=
